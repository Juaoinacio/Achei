{
  "name": "achei-backend",
  "version": "1.0.0",
  "description": "Backend para o sistema de Achados e Perdidos da faculdade",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
