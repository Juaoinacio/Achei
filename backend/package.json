    "express": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.11.11",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
